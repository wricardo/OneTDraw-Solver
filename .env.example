# One T Draw — server configuration. Copy to .env for local development.

# HTTP port (the -port flag wins when given).
PORT=8090

# Admin key for map editing (X-Admin-Key header). Unset disables the editor
# entirely unless ALLOW_UNAUTHENTICATED_ADMIN is true.
# ADMIN_API_KEY=change-me
# ALLOW_UNAUTHENTICATED_ADMIN=false

# Comma-separated websocket/CORS origin allowlist. Empty or * allows all.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8090

# GraphQL introspection and the /playground UI. Both default to enabled.
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true

# Live session cap and how long an idle session is kept on restart.
MAX_SESSIONS=1000
# SESSION_TTL=168h

# Frontend build-time overrides (used by `npm run dev`, not the Go server).
# PUBLIC_GRAPHQL_URL=http://localhost:8090/graphql
# PUBLIC_WS_URL=ws://localhost:8090/graphql
